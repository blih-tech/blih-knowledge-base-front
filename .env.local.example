# Real backend API base URL (server-only — no trailing slash).
# Used by lib/auth/auth-options.ts and the /api/proxy route handler.
BACKEND_API_URL=http://localhost:5000/api/v1

# NextAuth.js v4 — JWT session encryption secret.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Public URL of this app. Required in production; optional in dev (defaults to http://localhost:3000).
NEXTAUTH_URL=http://localhost:3000
