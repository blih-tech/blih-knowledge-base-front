# Real backend API base URL (server-only — no trailing slash).
# Used by auth.ts and the /api/proxy route handler.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_API_URL=https://blih-knowledge-base-backend.onrender.com/api/v1

# Auth.js session encryption secret. Generate with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Seeder credentials — used only by scripts/seed-documents.mjs


SEED_ADMIN_EMAIL=admin@blih.com
SEED_ADMIN_PASS=Admin@1234